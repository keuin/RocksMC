{
  "__inputs": [],
  "__requires": [],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "rocksmc: RocksDB storage backend for Minecraft. Datasource and dimension are template variables, so nothing is hardcoded to one environment.",
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "panels": [],
      "title": "Health — watch these first",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "1 when the exporter is serving. If this is absent the mod is not loaded, the backend is 'anvil', or metrics-enabled=false.",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "color": "red", "index": 1, "text": "DOWN" } }, "type": "value" },
            { "options": { "1": { "color": "green", "index": 0, "text": "UP" } }, "type": "value" }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 3, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "max(rocksmc_up{instance=~\"$instance\"})",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Exporter",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "ANY non-zero value is an incident: compaction cannot keep up and chunk writes are fully blocked, which will stall the tick loop. Raise max-background-jobs.",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "color": "green", "index": 0, "text": "OK" } }, "type": "value" }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 3, "x": 3, "y": 1 },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "max(rocksmc_write_stopped{instance=~\"$instance\"})",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Writes stopped",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "MUST stay 0. Any increase means the storage layer read back something different from what it wrote — stop the server and roll back to backend=anvil. Only populated when verify-on-read=true.",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "color": "green", "index": 0, "text": "0" } }, "type": "value" }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "dark-red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 3, "x": 6, "y": 1 },
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rocksmc_verify_failures_total{instance=~\"$instance\"})",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Verify failures",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Read plus write failures across all stores. Non-zero means chunks are failing to load or save.",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "color": "green", "index": 0, "text": "0" } }, "type": "value" }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 3, "x": 9, "y": 1 },
      "id": 4,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rocksmc_read_failures_total{instance=~\"$instance\"}) + sum(rocksmc_write_failures_total{instance=~\"$instance\"})",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "IO failures",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Open RocksDB stores. Expect 2 per loaded dimension (region + poi), so 6 once all three vanilla dimensions have been visited. A dimension's store only opens when something loads it.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "text", "value": null }]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 3, "x": 12, "y": 1 },
      "id": 5,
      "options": {
        "colorMode": "none",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "max(rocksmc_stores{instance=~\"$instance\"})",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Open stores",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Total bytes on disk: blob files (where chunk values live) plus live SST files.",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "text", "value": null }]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 15, "y": 1 },
      "id": 6,
      "options": {
        "colorMode": "none",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rocksmc_blob_file_bytes{instance=~\"$instance\"}) + sum(rocksmc_live_sst_bytes{instance=~\"$instance\"})",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "On-disk size",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Chunks stored, estimated by RocksDB from its own key count.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "text", "value": null }]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 5, "x": 19, "y": 1 },
      "id": 7,
      "options": {
        "colorMode": "none",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rocksmc_estimated_keys{instance=~\"$instance\"})",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Chunks stored (est.)",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "panels": [],
      "title": "Write pressure — the leading indicator of tick lag",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Compaction the engine still owes. A steady climb means background work is losing to incoming writes; that ends in throttling and then a full stop. Raise max-background-jobs or max-subcompactions.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 10,
      "options": {
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "rocksmc_pending_compaction_bytes{instance=~\"$instance\", dimension=~\"$dimension\"}",
          "legendFormat": "{{dimension}} {{store}}",
          "refId": "A"
        }
      ],
      "title": "Pending compaction backlog",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Non-zero means RocksDB has begun throttling writes to let compaction catch up. This is the early warning before writes stop entirely.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 30,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "Bps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 11,
      "options": {
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "rocksmc_delayed_write_rate{instance=~\"$instance\", dimension=~\"$dimension\"}",
          "legendFormat": "{{dimension}} {{store}}",
          "refId": "A"
        }
      ],
      "title": "Write throttling (0 = healthy)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Background compactions and flushes in flight. Sustained saturation at max-background-jobs means the engine is at its configured limit.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": { "mode": "none" }
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 14 },
      "id": 12,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rocksmc_running_compactions{instance=~\"$instance\", dimension=~\"$dimension\"})",
          "legendFormat": "compactions running",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rocksmc_running_flushes{instance=~\"$instance\", dimension=~\"$dimension\"})",
          "legendFormat": "flushes running",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rocksmc_compaction_pending{instance=~\"$instance\", dimension=~\"$dimension\"})",
          "legendFormat": "stores with compaction queued",
          "refId": "C"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rocksmc_memtable_flush_pending{instance=~\"$instance\", dimension=~\"$dimension\"})",
          "legendFormat": "stores with flush queued",
          "refId": "D"
        }
      ],
      "title": "Background work",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Memory held by memtables. Rising toward write-buffer-size x max-write-buffer-number means flushes are not keeping pace.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": { "mode": "normal" }
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 14 },
      "id": 13,
      "options": {
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "rocksmc_memtable_bytes{instance=~\"$instance\", dimension=~\"$dimension\"}",
          "legendFormat": "{{dimension}} {{store}}",
          "refId": "A"
        }
      ],
      "title": "Memtable memory",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 21 },
      "id": 102,
      "panels": [],
      "title": "Chunk activity",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Chunk operations per second, split by dimension. Reads spike when players explore; writes cluster at the 5-minute autosave.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "id": 20,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (dimension) (rate(rocksmc_chunk_reads_total{instance=~\"$instance\", dimension=~\"$dimension\"}[$__rate_interval]))",
          "legendFormat": "read {{dimension}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (dimension) (rate(rocksmc_chunk_writes_total{instance=~\"$instance\", dimension=~\"$dimension\"}[$__rate_interval]))",
          "legendFormat": "write {{dimension}}",
          "refId": "B"
        }
      ],
      "title": "Chunk read / write rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Uncompressed NBT throughput as seen by the mod, before the engine compresses it. Real chunks average roughly 19-51 KiB uncompressed.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "Bps"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
      "id": 21,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (dimension) (rate(rocksmc_bytes_read_total{instance=~\"$instance\", dimension=~\"$dimension\"}[$__rate_interval]))",
          "legendFormat": "read {{dimension}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (dimension) (rate(rocksmc_bytes_written_total{instance=~\"$instance\", dimension=~\"$dimension\"}[$__rate_interval]))",
          "legendFormat": "write {{dimension}}",
          "refId": "B"
        }
      ],
      "title": "NBT throughput (uncompressed)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Mean uncompressed bytes per chunk operation. A sudden jump usually means a few very large chunks — storage halls, mob farms, heavy tile-entity concentrations.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 30 },
      "id": 22,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (dimension) (rate(rocksmc_bytes_written_total{instance=~\"$instance\", dimension=~\"$dimension\"}[$__rate_interval]))\n/ clamp_min(sum by (dimension) (rate(rocksmc_chunk_writes_total{instance=~\"$instance\", dimension=~\"$dimension\"}[$__rate_interval])), 1)",
          "legendFormat": "write {{dimension}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (dimension) (rate(rocksmc_bytes_read_total{instance=~\"$instance\", dimension=~\"$dimension\"}[$__rate_interval]))\n/ clamp_min(sum by (dimension) (rate(rocksmc_chunk_reads_total{instance=~\"$instance\", dimension=~\"$dimension\"}[$__rate_interval])), 1)",
          "legendFormat": "read {{dimension}}",
          "refId": "B"
        }
      ],
      "title": "Mean chunk size",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Cumulative failures. All three should be flat at zero; any slope is a defect, not a tuning problem.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 30,
            "lineWidth": 2,
            "showPoints": "auto"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 30 },
      "id": 23,
      "options": {
        "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rocksmc_read_failures_total{instance=~\"$instance\", dimension=~\"$dimension\"})",
          "legendFormat": "read failures",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rocksmc_write_failures_total{instance=~\"$instance\", dimension=~\"$dimension\"})",
          "legendFormat": "write failures",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rocksmc_verify_failures_total{instance=~\"$instance\", dimension=~\"$dimension\"})",
          "legendFormat": "verify failures",
          "refId": "C"
        }
      ],
      "title": "Failures (must stay flat at 0)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 37 },
      "id": 103,
      "panels": [],
      "title": "Storage and compression",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Where bytes actually live. Blob files hold the chunk values because key-value separation is enabled; SST files hold keys and blob pointers, which is why they are tiny by comparison.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 25,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": { "mode": "normal" }
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 38 },
      "id": 30,
      "options": {
        "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (dimension) (rocksmc_blob_file_bytes{instance=~\"$instance\", dimension=~\"$dimension\"})",
          "legendFormat": "blob {{dimension}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (dimension) (rocksmc_live_sst_bytes{instance=~\"$instance\", dimension=~\"$dimension\"})",
          "legendFormat": "sst {{dimension}}",
          "refId": "B"
        }
      ],
      "title": "On-disk bytes by dimension",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Obsolete SST bytes: total minus live. A persistent gap means compaction is not reclaiming space. Should trend toward zero when idle.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 1,
            "showPoints": "never"
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 38 },
      "id": 31,
      "options": {
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
