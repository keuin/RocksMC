          "expr": "sum by (dimension) (rate(rocksmc_bytes_written_total{instance=~\"$instance\", dimension=~\"$dimension\"}[$__rate_interval]))\n/ clamp_min(sum by (dimension) (rate(rocksmc_chunk_writes_total{instance=~\"$instance\", dimension=~\"$dimension\"}[$__rate_interval])), 1)",
          "legendFormat": "write {{dimension}}",
          "refId": "A"
        },
        {
