    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Blob files hold nearly all chunk bytes and carry no column family in their names, so they are reported per database. SST files are per column family. Neither can be attributed to a single dimension: all dimensions share both.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 25,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          },
          "unit": "bytes"
        },
        "overrides": []
