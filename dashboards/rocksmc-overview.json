          },
          "expr": "sum(rocksmc_blob_file_bytes{instance=~\"$instance\"})",
          "legendFormat": "blob (all dimensions)",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (column_family) (rocksmc_live_sst_bytes_by_cf{instance=~\"$instance\"})",
