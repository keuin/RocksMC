          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "clamp_min(sum by (column_family) (rocksmc_total_sst_bytes_by_cf{instance=~\"$instance\"}) - sum by (column_family) (rocksmc_live_sst_bytes_by_cf{instance=~\"$instance\"}), 0)",
          "legendFormat": "{{column_family}}",
          "refId": "A"
        }
      ],
      "title": "Obsolete SST bytes awaiting reclaim",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Total on-disk bytes divided by stored entries, across the whole database. Not split per column family: blob files hold nearly all the bytes and are not attributable to one, so any per-column-family ratio would be wrong for both. Compare against ~3.5 KiB per chunk for vanilla Anvil.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "bytes"
        },
