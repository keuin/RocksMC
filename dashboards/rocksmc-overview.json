            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(sum(rocksmc_blob_file_bytes{instance=~\"$instance\"}) + sum(rocksmc_live_sst_bytes_by_cf{instance=~\"$instance\"}))\n/ clamp_min(sum(rocksmc_estimated_keys_by_cf{instance=~\"$instance\"}), 1)",
          "legendFormat": "{{database}}",
          "refId": "A"
        }
