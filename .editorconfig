# Keeps indentation consistent so the tab-to-space conversion is not silently
# undone by an editor. Supported natively by IntelliJ IDEA and most editors.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{java,gradle}]
indent_style = space
indent_size = 4

[*.{json,yml,yaml}]
indent_style = space
indent_size = 2

[*.{properties,md}]
indent_style = space
indent_size = 4

# Generated by `gradle wrapper`; regenerating reintroduces tabs, so leave these
# alone rather than fighting the generator on every upgrade.
[{gradlew,gradlew.bat,gradle/wrapper/gradle-wrapper.properties}]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = false

# Grafana re-exports with tabs, so a dashboard edited in the UI would otherwise
# churn against this rule every time it is saved.
[dashboards/*.json]
indent_style = unset
indent_size = unset

[Makefile]
indent_style = tab
